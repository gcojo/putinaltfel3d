// Configurare Cloudflare Workers: publică aplicația ca site static din dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "putinaltfel3d",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // orice rută necunoscută (ex. /comenzi la refresh) primește index.html
    "not_found_handling": "single-page-application"
  }
}
